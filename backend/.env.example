# Server Port (Default: 5001 to prevent macOS AirPlay port 5000 conflicts)
PORT=5001

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/course_management

# JWT Secret Key for Authentication
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL for CORS (Local development default; update to Vercel URL in production)
FRONTEND_URL=http://localhost:5173
